# Copy this file outside the repository and set DJC_ENV_FILE to its path.
# Never commit real credentials.
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_DATASOURCE_URL=jdbc:mysql://<DB_PRIVATE_IP>:3306/devjob?serverTimezone=Asia/Seoul&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=djc_app
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>
DB_PASSWORD=<DB_PASSWORD>
FLYWAY_USERNAME=djc_migrator
FLYWAY_PASSWORD=<FLYWAY_PASSWORD>
PUBLIC_DATA_COLLECTION_ENABLED=false
API_SERVICE_KEY=<API_SERVICE_KEY>
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>
SARAMIN_ACCESS_KEY=<SARAMIN_ACCESS_KEY>
AUTH_FRONTEND_SUCCESS_URI=https://<FRONTEND_DOMAIN>/oauth/callback
AUTH_TOKEN_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARS>

# Personal signup email and bot protection.
AUTH_SIGNUP_MAIL_ENABLED=false
AUTH_SIGNUP_MAIL_FROM=no-reply@<FRONTEND_DOMAIN>
AUTH_SIGNUP_TERMS_POLICY_VERSION=<TERMS_POLICY_VERSION>
AUTH_SIGNUP_PRIVACY_POLICY_VERSION=<PRIVACY_POLICY_VERSION>
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USERNAME>
MAIL_PASSWORD=<SMTP_PASSWORD>
AUTH_SIGNUP_TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=<TURNSTILE_SECRET_KEY>

# Shadow startup must keep all scheduled collection disabled.
ATS_COLLECTION_ENABLED=false
SARAMIN_COLLECTION_ENABLED=false
TOSS_COLLECTION_ENABLED=false
NAVER_COLLECTION_ENABLED=false

# Runtime image/tag controls used by compose.yaml.
DJC_ENV_FILE=.env.docker
DJC_IMAGE_REPOSITORY=ghcr.io/aerofleet/devjobcollector
DJC_IMAGE_TAG=<COMMIT_SHA>
DJC_BIND_ADDRESS=127.0.0.1
DJC_PORT=8080
